{
  "name": "offline-incident-queue",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first incident queue — Caygnus product engineering challenge, problem 1",
  "scripts": {
    "server": "node server/index.js",
    "test": "jest --testPathIgnorePatterns integration",
    "test:watch": "jest --watch",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:e2e": "jest __tests__/integration"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/react": "~19.2.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "~6.0.3"
  },
  "main": "index.js",
  "dependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "expo": "^57.0.23",
    "expo-sqlite": "^57.0.3",
    "expo-status-bar": "^57.0.1",
    "react": "19.2.3",
    "react-native": "^0.86.3"
  }
}
